{
  "title": "SchoolApex Modern UI",
  "description": "Modern Canvas UI powered by Carbon Design System with LTI 1.3 integration",
  "oidc_initiation_url": "https://your-domain.com/lti/login",
  "target_link_uri": "https://your-domain.com/lti/launch",
  "scopes": [
    "https://purl.imsglobal.org/spec/lti-ags/scope/lineitem",
    "https://purl.imsglobal.org/spec/lti-ags/scope/result.readonly",
    "https://purl.imsglobal.org/spec/lti-ags/scope/score",
    "https://purl.imsglobal.org/spec/lti-nrps/scope/contextmembership.readonly"
  ],
  "extensions": [
    {
      "domain": "your-domain.com",
      "tool_id": "schoolapex_modern_ui",
      "platform": "canvas.instructure.com",
      "settings": {
        "text": "SchoolApex Modern UI",
        "icon_url": "https://your-domain.com/icon.png",
        "placements": [
          {
            "text": "Modern UI",
            "enabled": true,
            "placement": "course_navigation",
            "message_type": "LtiResourceLinkRequest",
            "target_link_uri": "https://your-domain.com/lti/launch",
            "canvas_icon_class": "icon-lti",
            "windowTarget": "_self",
            "visibility": "public"
          },
          {
            "text": "Modern UI Dashboard",
            "enabled": true,
            "placement": "account_navigation",
            "message_type": "LtiResourceLinkRequest",
            "target_link_uri": "https://your-domain.com/lti/launch?placement=account_navigation",
            "canvas_icon_class": "icon-analytics",
            "windowTarget": "_self",
            "visibility": "admins"
          },
          {
            "text": "Select Modern UI Content",
            "enabled": true,
            "placement": "link_selection",
            "message_type": "LtiDeepLinkingRequest",
            "target_link_uri": "https://your-domain.com/lti/launch?placement=link_selection",
            "selection_height": 600,
            "selection_width": 900
          },
          {
            "text": "Modern UI Assignment",
            "enabled": true,
            "placement": "assignment_selection",
            "message_type": "LtiDeepLinkingRequest",
            "target_link_uri": "https://your-domain.com/lti/launch?placement=assignment_selection",
            "selection_height": 600,
            "selection_width": 900
          },
          {
            "text": "Modern UI Editor",
            "enabled": true,
            "placement": "editor_button",
            "message_type": "LtiDeepLinkingRequest",
            "target_link_uri": "https://your-domain.com/lti/launch?placement=editor_button",
            "selection_height": 500,
            "selection_width": 800,
            "icon_url": "https://your-domain.com/editor-icon.png"
          }
        ]
      }
    }
  ],
  "public_jwk_url": "https://your-domain.com/.well-known/jwks.json",
  "custom_fields": {
    "canvas_user_id": "$Canvas.user.id",
    "canvas_course_id": "$Canvas.course.id",
    "canvas_assignment_id": "$Canvas.assignment.id",
    "canvas_user_login_id": "$Canvas.user.loginId",
    "canvas_user_sis_id": "$Canvas.user.sisSourceId",
    "canvas_course_sis_id": "$Canvas.course.sisSourceId",
    "canvas_enrollment_state": "$Canvas.membership.status",
    "canvas_user_timezone": "$Canvas.user.timezone"
  },
  "privacy_level": "public"
}
