# LTI Service Configuration
PORT=4001
NODE_ENV=development

# Session Security
SESSION_SECRET=change_me_in_production_use_32_random_bytes

# LTI Tool Configuration
LTI_TOOL_KID=lti-tool-key-1
LTI_TOOL_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Canvas Platform Configuration (replace with your Canvas instance)
LTI_ISSUER=https://canvas.instructure.com
LTI_CLIENT_ID=your_developer_key_client_id
LTI_AUTHORIZATION_ENDPOINT=https://canvas.instructure.com/api/lti/authorize_redirect
LTI_TOKEN_ENDPOINT=https://canvas.instructure.com/login/oauth2/token
LTI_JWKS_ENDPOINT=https://canvas.instructure.com/api/lti/security/jwks

# Tool URLs (update BASE_URL for your deployment)
BASE_URL=http://localhost:4001
LTI_INITIATE_LOGIN_URI=${BASE_URL}/lti/login
LTI_REDIRECT_URI=${BASE_URL}/lti/launch

# Modern UI Frontend URL
MODERN_UI_URL=http://localhost:3001

# Optional: Canvas REST API (for OBO)
CANVAS_API_BASE_URL=https://canvas.instructure.com/api/v1
CANVAS_OAUTH_CLIENT_ID=your_oauth_client_id
CANVAS_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Observability
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_optional
