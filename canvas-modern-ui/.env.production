# Production Environment Configuration
# Copy this to .env.production.local and update with your values

# LTI Service Configuration
NODE_ENV=production
PORT=4001

# Session Security (CHANGE IN PRODUCTION)
SESSION_SECRET=your_secure_32_byte_session_secret_change_this_in_production

# LTI Tool Configuration
LTI_TOOL_KID=lti-tool-key-1
LTI_TOOL_PRIVATE_KEY_PEM="your_generated_private_key_from_generate_keys_script"

# Canvas Platform Configuration (UPDATE WITH YOUR CANVAS DOMAIN)
LTI_ISSUER=https://your-canvas-domain.instructure.com
LTI_CLIENT_ID=your_developer_key_client_id_from_canvas
LTI_AUTHORIZATION_ENDPOINT=https://your-canvas-domain.instructure.com/api/lti/authorize_redirect
LTI_TOKEN_ENDPOINT=https://your-canvas-domain.instructure.com/login/oauth2/token
LTI_JWKS_ENDPOINT=https://your-canvas-domain.instructure.com/api/lti/security/jwks

# Tool URLs (UPDATE WITH YOUR PRODUCTION DOMAIN)
BASE_URL=https://your-domain.com
LTI_INITIATE_LOGIN_URI=https://your-domain.com/lti/login
LTI_REDIRECT_URI=https://your-domain.com/lti/launch

# Modern UI Frontend URL
MODERN_UI_URL=https://your-domain.com

# Canvas REST API (for OBO)
CANVAS_API_BASE_URL=https://your-canvas-domain.instructure.com
CANVAS_OAUTH_CLIENT_ID=your_oauth_client_id
CANVAS_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Observability
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Optional: Redis for session storage
REDIS_URL=redis://redis:6379

# Optional: Database for persistent storage
DATABASE_URL=postgresql://user:password@localhost:5432/schoolapex_lti
