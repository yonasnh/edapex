# SchoolApex Modern UI - Production Environment Configuration
# This file contains production environment variables

# ================================
# Canvas OAuth2 Configuration
# ================================

# Canvas LMS instance base URL (production Canvas instance)
VITE_CANVAS_BASE_URL=https://your-production-canvas.instructure.com

# OAuth2 Client ID (production Canvas Developer Key Client ID)
VITE_CANVAS_CLIENT_ID=your-production-client-id

# OAuth2 Redirect URI for production
VITE_OAUTH2_REDIRECT_URI=https://app.schoolapex.com/auth/callback

# ================================
# SchoolApex Application Settings
# ================================

# Application metadata
VITE_APP_NAME=SchoolApex Modern UI
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# Application URLs
VITE_APP_BASE_URL=https://app.schoolapex.com
VITE_API_BASE_URL=https://api.schoolapex.com

# ================================
# Feature Flags
# ================================

# Core features
VITE_ENABLE_OAUTH2=true
VITE_ENABLE_REAL_API=true
VITE_ENABLE_MOCK_DATA=false

# Advanced features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GRADEBOOK=true
VITE_ENABLE_DISCUSSIONS=true
VITE_ENABLE_CALENDAR=true
VITE_ENABLE_FILES=true

# Experimental features
VITE_ENABLE_BULK_OPERATIONS=true
VITE_ENABLE_ADVANCED_SEARCH=true
VITE_ENABLE_NOTIFICATIONS=true

# ================================
# Production Settings
# ================================

# Debug and logging (disabled for production)
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error
VITE_ENABLE_CONSOLE_LOGS=false

# Development tools (disabled for production)
VITE_ENABLE_REACT_DEVTOOLS=false
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ================================
# Error Tracking & Monitoring
# ================================

# Sentry configuration
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production

# Analytics and monitoring
VITE_ANALYTICS_ENDPOINT=https://analytics.schoolapex.com/track
VITE_PERFORMANCE_ENDPOINT=https://monitoring.schoolapex.com/metrics

# ================================
# CDN & Assets
# ================================

# CDN configuration
VITE_CDN_BASE_URL=https://cdn.schoolapex.com
VITE_ASSETS_BASE_URL=https://assets.schoolapex.com

# ================================
# Security Settings
# ================================

# CORS settings
VITE_ALLOWED_ORIGINS=https://app.schoolapex.com,https://www.schoolapex.com

# Content Security Policy
VITE_CSP_REPORT_URI=https://security.schoolapex.com/csp-report

# ================================
# Performance Settings
# ================================

# Bundle optimization
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_PRELOADING=true

# Caching (production values)
VITE_CACHE_TTL=900000
VITE_ENABLE_SERVICE_WORKER=true

# ================================
# UI/UX Settings
# ================================

# Theme and branding
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_BRAND_PRIMARY_COLOR=#0066cc
VITE_BRAND_SECONDARY_COLOR=#f4f4f4

# Accessibility
VITE_ENABLE_HIGH_CONTRAST=true
VITE_ENABLE_REDUCED_MOTION=true
VITE_ENABLE_SCREEN_READER=true

# ================================
# Canvas Integration Settings
# ================================

# API configuration (production values)
VITE_CANVAS_API_VERSION=v1
VITE_CANVAS_API_TIMEOUT=30000
VITE_CANVAS_API_RETRY_ATTEMPTS=3

# Rate limiting (production values)
VITE_API_RATE_LIMIT=1000
VITE_API_RATE_WINDOW=60000

# ================================
# Build Settings
# ================================

# Build optimization
VITE_MINIFY=true
VITE_SOURCE_MAPS=false
VITE_TREE_SHAKING=true

# Output configuration
VITE_OUTPUT_DIR=dist
VITE_ASSETS_DIR=assets
VITE_PUBLIC_BASE_PATH=/
