# SchoolApex Modern UI - Environment Configuration Template
# Copy this file to .env.local for development or .env.production for production

# ================================
# Canvas OAuth2 Configuration
# ================================

# Canvas LMS instance base URL (without trailing slash)
VITE_CANVAS_BASE_URL=https://your-canvas-instance.instructure.com

# OAuth2 Client ID from Canvas Developer Keys
VITE_CANVAS_CLIENT_ID=your-canvas-client-id

# OAuth2 Redirect URI (must match Canvas configuration exactly)
VITE_OAUTH2_REDIRECT_URI=http://localhost:3001/auth/callback

# ================================
# SchoolApex Application Settings
# ================================

# Application metadata
VITE_APP_NAME=SchoolApex Modern UI
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Application URLs
VITE_APP_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001/api

# ================================
# Feature Flags
# ================================

# Core features
VITE_ENABLE_OAUTH2=true
VITE_ENABLE_REAL_API=true
VITE_ENABLE_MOCK_DATA=false

# Advanced features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GRADEBOOK=true
VITE_ENABLE_DISCUSSIONS=true
VITE_ENABLE_CALENDAR=true
VITE_ENABLE_FILES=true

# Experimental features
VITE_ENABLE_BULK_OPERATIONS=true
VITE_ENABLE_ADVANCED_SEARCH=true
VITE_ENABLE_NOTIFICATIONS=true

# ================================
# Development Settings
# ================================

# Debug and logging
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGS=true

# Development tools
VITE_ENABLE_REACT_DEVTOOLS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ================================
# Production Settings
# ================================

# Error tracking (Sentry)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics and monitoring
VITE_ANALYTICS_ENDPOINT=
VITE_PERFORMANCE_ENDPOINT=

# CDN and assets
VITE_CDN_BASE_URL=
VITE_ASSETS_BASE_URL=

# ================================
# Security Settings
# ================================

# CORS settings
VITE_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Content Security Policy
VITE_CSP_REPORT_URI=

# ================================
# Performance Settings
# ================================

# Bundle optimization
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_PRELOADING=true

# Caching
VITE_CACHE_TTL=300000
VITE_ENABLE_SERVICE_WORKER=false

# ================================
# UI/UX Settings
# ================================

# Theme and branding
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_BRAND_PRIMARY_COLOR=#0066cc
VITE_BRAND_SECONDARY_COLOR=#f4f4f4

# Accessibility
VITE_ENABLE_HIGH_CONTRAST=true
VITE_ENABLE_REDUCED_MOTION=true
VITE_ENABLE_SCREEN_READER=true

# ================================
# Canvas Integration Settings
# ================================

# API configuration
VITE_CANVAS_API_VERSION=v1
VITE_CANVAS_API_TIMEOUT=30000
VITE_CANVAS_API_RETRY_ATTEMPTS=3

# Rate limiting
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=60000

# ================================
# Testing Settings
# ================================

# Test environment
VITE_TEST_MODE=false
VITE_MOCK_API_DELAY=1000
VITE_ENABLE_TEST_IDS=true

# ================================
# Build Settings
# ================================

# Build optimization
VITE_MINIFY=true
VITE_SOURCE_MAPS=true
VITE_TREE_SHAKING=true

# Output configuration
VITE_OUTPUT_DIR=dist
VITE_ASSETS_DIR=assets
VITE_PUBLIC_BASE_PATH=/
