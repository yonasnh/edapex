# Canvas LMS GraphQL Configuration
# Copy this file to .env and update the values for your Canvas LMS instance

# The GraphQL endpoint for Canvas LMS
# For local development, use the Vite proxy to avoid CORS issues: /api/graphql
# For production, use your Canvas LMS domain: https://your-canvas-domain.com/api/graphql
VITE_GRAPHQL_ENDPOINT=/api/graphql

# Canvas API Token (optional - can be set via localStorage in the app)
# You can generate this from Canvas LMS Account Settings > Approved Integrations
# VITE_CANVAS_API_TOKEN=your_canvas_api_token_here

# Development Configuration
VITE_ENABLE_PERFORMANCE_MONITORING=true
NODE_ENV=development

# Staging Configuration (copy to .env.staging)
# VITE_SENTRY_DSN=https://staging-sentry-dsn@o1.ingest.sentry.io/123456
# VITE_SENTRY_ENVIRONMENT=staging
# VITE_API_PROXY_TARGET=https://canvas-staging.example.com

# Production Configuration (copy to .env.production)
# VITE_SENTRY_DSN=https://prod-sentry-dsn@o1.ingest.sentry.io/123456
# VITE_SENTRY_ENVIRONMENT=production
# VITE_API_PROXY_TARGET=https://canvas.example.com

# Additional Canvas LMS Configuration (if needed)
# VITE_CANVAS_BASE_URL=http://localhost:3000
# VITE_CANVAS_CLIENT_ID=your_oauth_client_id
# VITE_CANVAS_CLIENT_SECRET=your_oauth_client_secret
