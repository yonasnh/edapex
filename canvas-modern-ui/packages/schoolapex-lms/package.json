{
  "name": "@schoolapex/lms",
  "version": "1.0.0",
  "description": "SchoolApex LMS - Modern replacement for Canvas LMS using existing Canvas database",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@prisma/client": "^5.8.0",
    "apollo-server-express": "^3.12.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.22.4",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "lms",
    "education",
    "canvas",
    "graphql",
    "modern",
    "schoolapex"
  ],
  "author": "SchoolApex Team",
  "license": "MIT"
}
