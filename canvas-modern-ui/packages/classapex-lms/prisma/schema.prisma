generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CANVAS_DATABASE_URL")
}

model abstract_courses {
  id                                                  BigInt           @id @default(autoincrement())
  sis_source_id                                       String?          @db.VarChar(255)
  sis_batch_id                                        BigInt?
  account_id                                          BigInt
  root_account_id                                     BigInt
  short_name                                          String?          @db.VarChar(255)
  name                                                String?          @db.VarChar(255)
  created_at                                          DateTime         @db.Timestamp(6)
  updated_at                                          DateTime         @db.Timestamp(6)
  enrollment_term_id                                  BigInt
  workflow_state                                      String           @db.VarChar(255)
  stuck_sis_fields                                    String?
  accounts_abstract_courses_root_account_idToaccounts accounts         @relation("abstract_courses_root_account_idToaccounts", fields: [root_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_3077d9a014")
  enrollment_terms                                    enrollment_terms @relation(fields: [enrollment_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_87ef57da5a")
  sis_batches                                         sis_batches?     @relation(fields: [sis_batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_9c92877701")
  accounts_abstract_courses_account_idToaccounts      accounts         @relation("abstract_courses_account_idToaccounts", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_c38b94c5bc")
  courses                                             courses[]

  @@index([account_id], map: "index_abstract_courses_on_account_id")
  @@index([enrollment_term_id], map: "index_abstract_courses_on_enrollment_term_id")
  @@index([root_account_id, sis_source_id], map: "index_abstract_courses_on_root_account_id_and_sis_source_id")
  @@index([sis_source_id], map: "index_abstract_courses_on_sis_source_id")
}

model access_tokens {
  id                                      BigInt                   @id @default(autoincrement())
  developer_key_id                        BigInt
  user_id                                 BigInt?
  last_used_at                            DateTime?                @db.Timestamp(6)
  expires_at                              DateTime?                @db.Timestamp(6)
  purpose                                 String?                  @db.VarChar(255)
  created_at                              DateTime                 @db.Timestamp(6)
  updated_at                              DateTime                 @db.Timestamp(6)
  crypted_token                           String?                  @unique(map: "index_access_tokens_on_crypted_token") @db.VarChar(255)
  token_hint                              String?                  @db.VarChar(255)
  scopes                                  String?
  remember_access                         Boolean?
  crypted_refresh_token                   String?                  @unique(map: "index_access_tokens_on_crypted_refresh_token") @db.VarChar(255)
  workflow_state                          String                   @default("active") @db.VarChar
  root_account_id                         BigInt
  real_user_id                            BigInt?
  permanent_expires_at                    DateTime?                @db.Timestamp(6)
  users_access_tokens_user_idTousers      users?                   @relation("access_tokens_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_96fc070778")
  users_access_tokens_real_user_idTousers users?                   @relation("access_tokens_real_user_idTousers", fields: [real_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_ecb5f23187")
  notification_endpoints                  notification_endpoints[]

  @@unique([root_account_id, id], map: "index_access_tokens_replica_identity")
  @@index([developer_key_id, last_used_at], map: "index_access_tokens_on_developer_key_id_and_last_used_at")
  @@index([user_id], map: "index_access_tokens_on_user_id")
  @@index([workflow_state], map: "index_access_tokens_on_workflow_state")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accessibility_issues {
  id                             BigInt                       @id @default(autoincrement())
  root_account_id                BigInt
  course_id                      BigInt
  wiki_page_id                   BigInt?
  assignment_id                  BigInt?
  attachment_id                  BigInt?
  rule_type                      String                       @db.VarChar
  node_path                      String?                      @db.VarChar(1024)
  metadata                       Json                         @default("{}")
  workflow_state                 String                       @default("active") @db.VarChar
  updated_by_id                  BigInt?
  created_at                     DateTime                     @db.Timestamp(6)
  updated_at                     DateTime                     @db.Timestamp(6)
  accessibility_resource_scan_id BigInt
  users                          users?                       @relation(fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_45c5c138ab")
  courses                        courses                      @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_6e9f1a2f14")
  accessibility_resource_scans   accessibility_resource_scans @relation(fields: [accessibility_resource_scan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_794f8033d6")
  accounts                       accounts                     @relation(fields: [root_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_a661c7f6bb")
  wiki_pages                     wiki_pages?                  @relation(fields: [wiki_page_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_b7b23c5d21")
  assignments                    assignments?                 @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_d0e10fde2e")
  attachments                    attachments?                 @relation(fields: [attachment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_d1dda2c3ef")

  @@unique([root_account_id, id], map: "index_accessibility_issues_replica_identity")
  @@index([accessibility_resource_scan_id], map: "index_accessibility_issues_on_accessibility_resource_scan_id")
  @@index([course_id], map: "index_accessibility_issues_on_course_id")
  @@index([rule_type], map: "index_accessibility_issues_on_rule_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accessibility_resource_scans {
  id                      BigInt                 @id @default(autoincrement())
  root_account_id         BigInt
  course_id               BigInt
  wiki_page_id            BigInt?
  assignment_id           BigInt?
  attachment_id           BigInt?
  error_message           String?                @db.VarChar(255)
  workflow_state          String                 @default("queued") @db.VarChar
  created_at              DateTime               @db.Timestamp(6)
  updated_at              DateTime               @db.Timestamp(6)
  resource_name           String?                @db.VarChar(255)
  resource_workflow_state String                 @default("unpublished") @db.VarChar
  issue_count             Int                    @default(0)
  resource_updated_at     DateTime?              @db.Timestamp(6)
  accessibility_issues    accessibility_issues[]
  attachments             attachments?           @relation(fields: [attachment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_63f0c2dda4")
  assignments             assignments?           @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_7e9c2a73de")
  wiki_pages              wiki_pages?            @relation(fields: [wiki_page_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_8d11959132")
  courses                 courses                @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_bfde289996")
  accounts                accounts               @relation(fields: [root_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_cef6ed8ffa")

  @@unique([root_account_id, id], map: "index_accessibility_resource_scans_replica_identity")
  @@index([course_id], map: "index_accessibility_resource_scans_on_course_id")
  @@index([issue_count], map: "index_accessibility_resource_scans_on_issue_count")
  @@index([resource_name], map: "index_accessibility_resource_scans_on_resource_name")
  @@index([resource_workflow_state], map: "index_accessibility_resource_scans_on_resource_workflow_state")
}

model account_notification_roles {
  id                      BigInt                @id @default(autoincrement())
  account_notification_id BigInt
  role_id                 BigInt?
  workflow_state          String                @default("active") @db.VarChar(255)
  account_notifications   account_notifications @relation(fields: [account_notification_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_5948b12a95")
  roles                   roles?                @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_794b06ff0e")

  @@unique([account_notification_id, role_id], map: "index_account_notification_roles_on_role_id")
}

model account_notifications {
  id                         BigInt                       @id @default(autoincrement())
  subject                    String?                      @db.VarChar(255)
  icon                       String?                      @default("warning") @db.VarChar(255)
  message                    String?
  account_id                 BigInt
  user_id                    BigInt
  start_at                   DateTime                     @db.Timestamp(6)
  end_at                     DateTime                     @db.Timestamp(6)
  created_at                 DateTime                     @db.Timestamp(6)
  updated_at                 DateTime                     @db.Timestamp(6)
  required_account_service   String?                      @db.VarChar(255)
  months_in_display_cycle    Int?
  domain_specific            Boolean                      @default(false)
  send_message               Boolean                      @default(false)
  messages_sent_at           DateTime?                    @db.Timestamp(6)
  workflow_state             String                       @default("active") @db.VarChar(255)
  account_notification_roles account_notification_roles[]
  accounts                   accounts                     @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_9a3f0df4a1")
  users                      users                        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_f83172407d")

  @@index([account_id, end_at, start_at], map: "index_account_notifications_by_account_and_timespan")
  @@index([user_id], map: "index_account_notifications_on_user_id")
}

model account_report_rows {
  id                       BigInt                 @id @default(autoincrement())
  account_report_id        BigInt
  account_report_runner_id BigInt
  row_number               Int?
  row                      String[]               @default([]) @db.VarChar
  created_at               DateTime               @db.Timestamp(6)
  file                     String?                @db.VarChar
  account_reports          account_reports        @relation(fields: [account_report_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_bb695932fe")
  account_report_runners   account_report_runners @relation(fields: [account_report_runner_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_df404c1a41")

  @@index([account_report_id], map: "index_account_report_rows_on_account_report_id")
  @@index([account_report_runner_id], map: "index_account_report_rows_on_account_report_runner_id")
  @@index([created_at], map: "index_account_report_rows_on_created_at")
  @@index([file], map: "index_account_report_rows_on_file")
}

model account_report_runners {
  id                  BigInt                @id @default(autoincrement())
  account_report_id   BigInt
  workflow_state      String                @default("created") @db.VarChar(255)
  batch_items         String[]              @default([]) @db.VarChar
  created_at          DateTime              @db.Timestamp(6)
  updated_at          DateTime              @db.Timestamp(6)
  started_at          DateTime?             @db.Timestamp(6)
  ended_at            DateTime?             @db.Timestamp(6)
  job_ids             BigInt[]              @default([])
  account_report_rows account_report_rows[]
  account_reports     account_reports       @relation(fields: [account_report_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_e03a0118ae")

  @@index([account_report_id], map: "index_account_report_runners_on_account_report_id")
  @@index([created_at], map: "index_account_report_runners_on_created_at")
}

model account_reports {
  id                     BigInt                   @id @default(autoincrement())
  user_id                BigInt
  message                String?
  account_id             BigInt
  attachment_id          BigInt?
  workflow_state         String                   @default("created") @db.VarChar(255)
  report_type            String?                  @db.VarChar(255)
  progress               Int?
  created_at             DateTime                 @db.Timestamp(6)
  updated_at             DateTime                 @db.Timestamp(6)
  parameters             String?
  current_line           Int?
  total_lines            Int?
  start_at               DateTime?                @db.Timestamp(6)
  end_at                 DateTime?                @db.Timestamp(6)
  job_ids                BigInt[]                 @default([])
  account_report_rows    account_report_rows[]
  account_report_runners account_report_runners[]
  users                  users                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_1ee483dd34")
  attachments            attachments?             @relation(fields: [attachment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_58e7f750a2")
  accounts               accounts                 @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_865683f386")

  @@index([account_id, report_type, created_at(sort: Desc)], map: "index_account_reports_latest_of_type_per_account")
  @@index([attachment_id], map: "index_account_reports_on_attachment_id")
  @@index([user_id], map: "index_account_reports_on_user_id")
}

