{
  "name": "@schoolapex/core",
  "version": "0.1.0",
  "description": "SchoolApex Core - Revolutionary framework with Canvas integration utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./dist/config/design-tokens.css": "./dist/config/design-tokens.css",
    "./dist/config/component-tokens.css": "./dist/config/component-tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && pnpm copy-css",
    "copy-css": "for f in $(find src/config -name '*.css'); do target=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$target\")\"; cp \"$f\" \"$target\"; done",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7",
    "@tanstack/react-query": "^5.17.0",
    "zod": "^3.22.4",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/user-event": "^14.5.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}